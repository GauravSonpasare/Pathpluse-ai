# ==============================================================================
# PathPulse AI - Supabase Environment Configuration (Example Template)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Supabase Project Credentials
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Keep SECRET! Use only in secure server-side environments)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection String (Optional, for database migrations / Prisma / Drizzle)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Application Settings
APP_ENV=development
PORT=8080
